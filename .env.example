# Copy to .env (never commit .env)
# Owner role: owns the databases and runs the Flyway migrations. Keep it out of the services' runtime config.
DB_OWNER_USER=pos
DB_OWNER_PASSWORD=change-me
# App role: what the services connect as. Must stay a plain role so tenant isolation (row-level security) applies.
DB_USER=pos_app
DB_PASSWORD=change-me-too
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
# Password of the bootstrap admin user created on first start of user-api
ADMIN_PASSWORD=Admin#12345
# First login of the platform operator, who creates the client companies (tenants)
PLATFORM_PASSWORD=Platform#12345
APP_TIMEZONE=Asia/Manila

# Redis (caches, rate limiting, token blocklist). Leave empty for the local docker compose Redis.
REDIS_PASSWORD=
